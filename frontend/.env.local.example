# PUBLIC (exposed to browser, prefix NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# PRIVATE
# The frontend needs no server secrets: it signs in through Supabase with the
# anon key and calls the API with the user's session token. Never add the
# service-role key or the JWT signing secret here.

# PRODUCTION VALUES
# NEXT_PUBLIC_API_URL=https://api.devupecosystem.in
# NEXT_PUBLIC_APP_URL=https://devupecosystem.in
